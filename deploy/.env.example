# =====================================================================
# 环境变量清单（复制为 .env 后填写；.env 已被 .gitignore 排除，禁止提交）
#
#   cp deploy/.env.example deploy/.env
#
# 值全部留空或使用开发默认值：生产部署前必须逐项替换。
# =====================================================================

# ---------------- 数据库 ----------------
DB_NAME=codereview
DB_USER=codereview
DB_PASSWORD=codereview
DB_HOST=localhost
DB_PORT=5432

# ---------------- Redis ----------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------------- 对象存储（代码包 / 知识库文档） ----------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=codereview

# ---------------- 向量化服务 ----------------
# 生产环境请改为容器内的服务名（如 http://embedding:80）
EMBEDDING_URL=http://localhost:8090
EMBEDDING_PORT=8090
EMBEDDING_MODEL=BAAI/bge-m3
# 维度必须与数据库 vector(1024) 一致，改这里必须同时改表结构并重建索引
EMBEDDING_DIM=1024

# ---------------- 大模型（DeepSeek） ----------------
# 从系统环境变量注入，不要写在本文件里提交到仓库
# Windows: setx DEEPSEEK_API_KEY "sk-xxx"
# Linux/macOS: export DEEPSEEK_API_KEY="sk-xxx"
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------------- 应用 ----------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
LOG_LEVEL_APP=INFO

# JWT 密钥：Base64 编码且解码后 >= 32 字节
# 生成方式：openssl rand -base64 48
APP_JWT_SECRET=

# 首次启动创建的管理员；创建后请立即在系统内修改密码
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=Admin@123456

# 允许的前端来源（多个用逗号分隔，不要用 *，否则 Cookie 无法携带）
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 生产环境启用 HTTPS 后必须改为 true
APP_COOKIE_SECURE=false
